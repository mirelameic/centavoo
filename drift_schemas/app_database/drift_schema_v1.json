  "fixed_sql": [
    {
      "name": "trips_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trips_table\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"destination\" TEXT NULL, \"start_date\" TEXT NULL, \"end_date\" TEXT NULL, \"currency\" TEXT NOT NULL, \"cities_json\" TEXT NOT NULL DEFAULT '{}', \"city_list_json\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories_table\" (\"id\" TEXT NOT NULL, \"trip_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions_table\" (\"id\" TEXT NOT NULL, \"trip_id\" TEXT NOT NULL, \"period\" TEXT NOT NULL, \"date\" TEXT NULL, \"description\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"category_id\" TEXT NULL, \"kind\" TEXT NOT NULL, \"is_iof\" INTEGER NOT NULL CHECK (\"is_iof\" IN (0, 1)), \"split_count\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "category_rules_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category_rules_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"keyword\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"category_name\" TEXT NULL, \"priority\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "idx_categories_trip_sort",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_categories_trip_sort ON categories_table (trip_id, sort_order)"
        }
      ]
    },
    {
      "name": "idx_transactions_trip_period",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_transactions_trip_period ON transactions_table (trip_id, period)"
